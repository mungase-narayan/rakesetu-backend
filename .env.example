NODE_ENV=development
PORT=4000
APP_NAME=rakesetu-backend

DB_HOST=localhost
# 5432  = a Postgres installed locally. Scratch work only — it has no pgvector.
# 55433 = the pgvector/pgvector:pg16 container from `docker compose up -d postgres`.
#         This is the one migrations, the seed and `npm run dev` run against
#         (docs/phases/DECISIONS.md D1). 55432 belongs to the College-Level project.
DB_PORT=55433
DB_NAME=rakesetu
DB_USER=postgres
DB_PASSWORD=postgres
# TLS to Postgres. Defaults to on when NODE_ENV=production (managed Postgres),
# off otherwise. Set explicitly to false for a production-mode container talking
# to a plain Postgres on the same network.
DB_SSL=

# Identifies this replica behind a load balancer. Returned by /health and sent
# as the X-Instance-Id response header.
INSTANCE_ID=

# --- RabbitMQ ---------------------------------------------------------------
# Async AI jobs (ai.extraction / ai.explanation / ai.ingest). See DESIGN.md §3.
# false = the broker is never contacted and jobs run inline instead, which is
# what a serverless host (Vercel) needs since it cannot keep a consumer alive.
USE_RABBITMQ_SERVICE=true
# Required whenever USE_RABBITMQ_SERVICE is true.
# 5672  = a RabbitMQ installed locally.
# 5674  = the container from `docker compose up -d rabbitmq` (shifted so it can
#         never collide with a local broker, or with College-Level on 5673).
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# The backend publishes; rakesetu-ai-ml will consume. Until that service exists
# a placeholder consumer runs here — set false once it does.
RABBITMQ_CONSUME_AI_JOBS=true
# Unacked messages allowed per consumer.
RABBITMQ_PREFETCH=1

# --- Redis ------------------------------------------------------------------
# Idempotency keys, solver locks and (from Phase 5) the ETA cache. `/readyz`
# reports it, so the API starts without it but is not "ready" until it answers.
# 6379 = the container from `docker compose up -d redis`.
REDIS_URL=redis://localhost:6379
# Prefix on every key this service writes, so a shared Redis stays legible.
REDIS_KEY_PREFIX=rakesetu

# --- Rate limiting ----------------------------------------------------------
# Global budget per IP, and the stricter one guarding POST /users/login.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

JWT_ACCESS_SECRET=super_secret_access_key_dev
JWT_REFRESH_SECRET=super_secret_refresh_key_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5175
