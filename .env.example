NODE_ENV=development
PORT=4000
APP_NAME=rakesetu-backend

DB_HOST=localhost
# 5432  = a Postgres installed locally. Scratch work only — it has no pgvector.
# 55433 = the pgvector/pgvector:pg16 container from `docker compose up -d postgres`.
#         This is the one migrations, the seed and `npm run dev` run against
#         (docs/phases/DECISIONS.md D1). 55432 belongs to the College-Level project.
DB_PORT=55433
DB_NAME=rakesetu
DB_USER=postgres
DB_PASSWORD=postgres
# TLS to Postgres. Defaults to on when NODE_ENV=production (managed Postgres),
# off otherwise. Set explicitly to false for a production-mode container talking
# to a plain Postgres on the same network.
DB_SSL=

# Identifies this replica behind a load balancer. Returned by /health and sent
# as the X-Instance-Id response header.
INSTANCE_ID=

# --- RabbitMQ ---------------------------------------------------------------
# Async AI jobs (ai.extraction / ai.explanation / ai.ingest). See DESIGN.md §3.
# false = the broker is never contacted and jobs run inline instead, which is
# what a serverless host (Vercel) needs since it cannot keep a consumer alive.
USE_RABBITMQ_SERVICE=true
# Required whenever USE_RABBITMQ_SERVICE is true.
# 5672  = a RabbitMQ installed locally.
# 5674  = the container from `docker compose up -d rabbitmq` (shifted so it can
#         never collide with a local broker, or with College-Level on 5673).
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# The backend publishes; rakesetu-ai-ml will consume. Until that service exists
# a placeholder consumer runs here — set false once it does.
RABBITMQ_CONSUME_AI_JOBS=true
# Unacked messages allowed per consumer.
RABBITMQ_PREFETCH=1

# --- Redis ------------------------------------------------------------------
# Idempotency keys, solver locks and (from Phase 5) the ETA cache. `/readyz`
# reports it, so the API starts without it but is not "ready" until it answers.
# 6379 = the container from `docker compose up -d redis`.
REDIS_URL=redis://localhost:6379
# Prefix on every key this service writes, so a shared Redis stays legible.
REDIS_KEY_PREFIX=rakesetu

# --- Rate limiting ----------------------------------------------------------
# Global budget per IP, and the stricter one guarding POST /users/login.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

JWT_ACCESS_SECRET=super_secret_access_key_dev
JWT_REFRESH_SECRET=super_secret_refresh_key_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5175

# ---- Mail (invitations & password resets) -----------------------------------
# The same six variable names college-level-backend uses, so one set of SMTP
# credentials works for both projects.
#
# Transactional mail is asynchronous: the API writes an `email_jobs` row and
# publishes onto `email.send`; a consumer in this process renders and sends it.
# Nothing about delivery is reported in the HTTP response, and no link is ever
# returned over HTTP — a live credential in a response body ends up in logs,
# proxies and browser history.
#
# TLS is derived from the port, not configured: 465 is implicit TLS, 587 and 25
# upgrade with STARTTLS.
#
# For local work `docker compose up -d mailpit` gives a real SMTP server with a
# web inbox on http://localhost:8026 — host `localhost`, port 1026, no auth.
# Point these at a real relay instead and mail leaves the machine.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=RakeSetu
SMTP_FROM_EMAIL=no-reply@rakesetu.dev

# How long a link stays good. An invitation goes to somebody who may be on
# leave; a reset link is a live credential for an existing account and the
# person asking for it is at their keyboard right now.
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_HOURS=1

# Delivery attempts inside the queue consumer before a message is dead-lettered,
# and the backoff base between them. Three attempts covers the common transient
# SMTP failure; a hard failure lands in email.send.failed and the admin resends.
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_MS=1000

# Invitation and password endpoints, per IP per window. Caps token guessing and
# stops the API being used to mail-bomb somebody else's inbox.
PASSWORD_RATE_LIMIT_MAX=10
TOKEN_RATE_LIMIT_MAX=60

# ---------------------------------------------------------------------------
# Object storage (§8) — documents, circulars, waiver evidence.
#
# `docker compose up -d minio` gives a real S3 API on http://localhost:9100 with
# a console on http://localhost:9101 (minioadmin / minioadmin), and the
# `minio-init` one-shot creates both buckets. Leave S3_ENDPOINT empty to talk to
# real AWS S3 instead; nothing else changes.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9100
S3_FORCE_PATH_STYLE=true
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PRIVATE_BUCKET=rakesetu
S3_PUBLIC_BUCKET=rakesetu-public

# A presigned download URL is a bearer token for the object. Fifteen minutes is
# long enough to click and short enough that a URL pasted into a chat is dead
# before anybody reads it. It is never stored in the database.
S3_DOWNLOAD_URL_TTL_SECONDS=900
S3_MAX_UPLOAD_BYTES=52428800
